        <ComboBox DropDownClosed ="isChosen" x:Name="cboStdg" HorizontalAlignment="Left" Margin="272,164,0,0" VerticalAlignment="Top" Width="200" Height="30">
            <ComboBoxItem Content="Intelligent Systems Design"/>
            <ComboBoxItem Content="Energietechnik und Ressourcenoptimierung"/>
            <ComboBoxItem Content="Interkulturelle Wirtschaftspsychologie"/>
            <ComboBoxItem Content="Angewandte Informatik und Soziale medien"/>
            <ComboBoxItem Content="Betriebswirtschaftslehre"/>
            <ComboBoxItem Content="Biomedizinische Technologie"/>
            <ComboBoxItem Content="Computervisualistik und Design"/>
        </ComboBox>

    </Grid>
</Page>
