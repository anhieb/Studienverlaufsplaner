      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Studienverlaufsplaner"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page1">

    <Grid>
        <Button x:Name="next" IsEnabled="False" Click="nextButton_Click" Content="weiter" HorizontalAlignment="Left" Margin="503,333,0,0" VerticalAlignment="Top" Width="75"/>

